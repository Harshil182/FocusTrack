# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB (filled in during Module 3 — MongoDB Configuration)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/focustrack

# JWT (filled in during Module 4 — Authentication)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
